# Local development only. GitHub Actions uses repository Secrets.
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

APP_PORT=8080
DOCKER_CONTAINER=git-manager

# Production is set automatically by deploy.sh to the Cloudflare Worker URL.
EXTERNAL_BASE_URL=
