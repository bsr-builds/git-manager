# Local development only. GitHub Actions uses repository Secrets.
FLASK_SECRET_KEY=change-this-to-a-long-random-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-oauth-app-client-secret
GA_CLIENT_ID=your-github-app-client-id
GA_CLIENT_SECRET=your-github-app-client-secret

APP_PORT=8080
DOCKER_CONTAINER=git-manager

# Production is set automatically by deploy.sh to the Cloudflare Worker URL.
EXTERNAL_BASE_URL=

# Application access tokens (optional; defaults are safe for normal deployments)
# Keep this stable. Changing it invalidates existing generated app tokens.
APP_TOKEN_ENCRYPTION_SECRET=
# APP_TOKEN_DB_PATH=/app/data/access_tokens.db

# GitHub API token generation
# GA_CLIENT_ID / GA_CLIENT_SECRET are the GitHub App credentials used for login and in-project token generation.
# GA_CLIENT_ID / GA_CLIENT_SECRET are the GitHub App credentials used to authorize the
# GitHub App and create GitHub-issued scoped user tokens.
# Normal Token uses GitHub's scoped user-token endpoint. Classic PATs cannot
# be created programmatically by GitHub and must be created manually.
